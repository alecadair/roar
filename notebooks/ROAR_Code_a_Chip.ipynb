    "    \"                     color=cmap[i], linewidth=2, label=label)\\n\",\n",
    "    \"        ax2.semilogy(df.loc[mask, 'kgm'], df.loc[mask, 'ft'],\\n\",\n",
    "    \"                     color=cmap[i], linewidth=2, label=label)\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax1.set_xlabel('gm/ID [V⁻¹]')\\n\",\n",
    "    \"ax1.set_ylabel('Intrinsic Gain gm·rₒ [V/V]')\\n\",\n",
    "    \"ax1.set_title('NMOS Intrinsic Gain vs. Channel Length\\\\n(TT, 25°C)', fontweight='bold')\\n\",\n",
    "    \"ax1.legend(title='Channel Length', fontsize=9)\\n\",\n",
    "    \"ax1.grid(True, alpha=0.3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax2.set_xlabel('gm/ID [V⁻¹]')\\n\",\n",
    "    \"ax2.set_ylabel('Transit Frequency fₜ [Hz]')\\n\",\n",
    "    \"ax2.set_title('NMOS Transit Frequency vs. Channel Length\\\\n(TT, 25°C)', fontweight='bold')\\n\",\n",
    "    \"ax2.legend(title='Channel Length', fontsize=9)\\n\",\n",
    "    \"ax2.grid(True, alpha=0.3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"---\\n\",\n",
    "    \"## 5. Equation-Based Design: Current-Mirror OTA\\n\",\n",
    "    \"\\n\",\n",
    "    \"ROAR's **Design Editor** allows the designer to express analog design equations symbolically. Expressions can reference **LUT lookups** (e.g., `kgm:M1_2` reads the gm/ID column from the LUT assigned to instance M1_2) and are automatically resolved using topological sorting of the dependency graph.\\n\",\n",
    "    \"\\n\",\n",
    "    \"### 5.1 Circuit Architecture\\n\",\n",
    "    \"\\n\",\n",
    "    \"We design a **single-stage current-mirror OTA** (folded architecture), a workhorse topology for many analog applications. The circuit has four transistor groups:\\n\",\n",
    "    \"\\n\",\n",
    "    \"| Instance | Role | Type | Sizing |\\n\",\n",
    "    \"|----------|------|------|--------|\\n\",\n",
    "    \"| **M1_2** | Input diff pair | NMOS (n_01v8) | L = 500 nm |\\n\",\n",
    "    \"| **M3_4** | Diode-connected loads | PMOS (p_01v8) | L = 500 nm |\\n\",\n",
    "    \"| **M5_6** | Current mirrors (NMOS) | NMOS (n_01v8) | L = 500 nm |\\n\",\n",
    "    \"| **M7_8** | Current mirrors (PMOS) | PMOS (p_01v8) | L = 500 nm |\\n\",\n",
    "    \"\\n\",\n",
    "    \"### 5.2 Design Specifications\\n\",\n",
    "    \"\\n\",\n",
    "    \"| Parameter | Value |\\n\",\n",
    "    \"|-----------|-------|\\n\",\n",
    "    \"| Unity-gain frequency (fᵤ) | 100 MHz |\\n\",\n",
    "    \"| Load capacitance (C_L) | 10 pF |\\n\",\n",
    "    \"| Voltage gain (Aᵥ) | ≥ 30 dB |\\n\",\n",
    "    \"| Supply voltage (VDD) | 1.8 V |\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Load the CM OTA design JSON (same file the ROAR GUI saves/loads)\\n\",\n",
    "    \"with open(os.path.join(ROAR_HOME, 'design', 'current_mirror_ota.json'), 'r') as f:\\n\",\n",
    "    \"    cm_ota_design = json.load(f)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"=\\\" * 70)\\n\",\n",
    "    \"print(\\\"CURRENT-MIRROR OTA — Design Equations\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 70)\\n\",\n",
    "    \"print(f\\\"{'Symbol':<20} {'Expression':<50}\\\")\\n\",\n",
    "    \"print(\\\"-\\\" * 70)\\n\",\n",
    "    \"for eq in cm_ota_design['expression_editor']:\\n\",\n",
    "    \"    sym = eq['Symbol']\\n\",\n",
    "    \"    expr = eq['Expression']\\n\",\n",
    "    \"    print(f\\\"{sym:<20} {expr:<50}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\" * 70)\\n\",\n",
    "    \"print(\\\"Instance Table\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 70)\\n\",\n",
    "    \"print(f\\\"{'Instance':<12} {'Corners':<50}\\\")\\n\",\n",
    "    \"print(\\\"-\\\" * 70)\\n\",\n",
    "    \"for inst in cm_ota_design['instance_table']:\\n\",\n",
    "    \"    print(f\\\"{inst['Instance']:<12} {inst['Corners']:<50}\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### 5.3 Setting Up the Equation Solver Programmatically\\n\",\n",
    "    \"\\n\",\n",
    "    \"We now replicate what the ROAR GUI does: instantiate the `ROAREquationSolver`, load corner DataFrames, add the design equations, and evaluate them across all sweep points and PVT corners.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"def build_corner_dfs(design_json):\\n\",\n",
    "    \"    \\\"\\\"\\\"Build the device-namespaced corner DataFrames dict from a design JSON.\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    Returns a dict with keys like 'M1_2::PDK>SKY130A>n_01v8>500>nfettt75'\\n\",\n",
    "    \"    mapping to pandas DataFrames.\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    lut_base = os.path.join(ROAR_HOME, 'characterization', 'sky130', 'LUTs_SKY130')\\n\",\n",
    "    \"    corner_dfs = {}\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    for inst in design_json['instance_table']:\\n\",\n",
    "    \"        instance_name = inst['Instance']\\n\",\n",
    "    \"        for corner_data in inst.get('_corners_data', []):\\n\",\n",
    "    \"            model = corner_data['model']\\n\",\n",
    "    \"            length = corner_data['length']\\n\",\n",
    "    \"            name = corner_data['name']\\n\",\n",
    "    \"            path_key = corner_data['path']\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            # Determine N or P from the model name\\n\",\n",
    "    \"            if 'n_' in model:\\n\",\n",
    "    \"                prefix = 'N'\\n\",\n",
    "    \"            else:\\n\",\n",
    "    \"                prefix = 'P'\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            lut_dir = f'LUT_{prefix}_{length}'\\n\",\n",
    "    \"            csv_path = os.path.join(lut_base, model, lut_dir, f'{name}.csv')\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            if os.path.exists(csv_path):\\n\",\n",
    "    \"                corner = CIDCorner(corner_name=name, lut_csv=csv_path, vdd=1.8)\\n\",\n",
    "    \"                ns_key = f\\\"{instance_name}::{path_key}\\\"\\n\",\n",
    "    \"                corner_dfs[ns_key] = corner.df\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    return corner_dfs\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def setup_solver(design_json):\\n\",\n",
    "    \"    \\\"\\\"\\\"Create and configure a ROAREquationSolver from a design JSON.\\\"\\\"\\\"\\n\",\n",
    "    \"    corner_dfs = build_corner_dfs(design_json)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Create solver\\n\",\n",
    "    \"    solver = ROAREquationSolver(top_level_app=None)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Add equations from the design JSON\\n\",\n",
    "    \"    symbols_to_add = []\\n\",\n",
    "    \"    for eq in design_json['expression_editor']:\\n\",\n",
    "    \"        if not eq.get('disabled', False):\\n\",\n",
    "    \"            sym = eq['Symbol']\\n\",\n",
    "    \"            expr = eq['Expression']\\n\",\n",
    "    \"            error = solver.add_equation(sym, expr)\\n\",\n",
    "    \"            if error:\\n\",\n",
    "    \"                print(f\\\"  Warning: {sym} = {expr} → {error}\\\")\\n\",\n",
    "    \"            symbols_to_add.append(sym)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    return solver, corner_dfs, symbols_to_add\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Build the solver for the CM OTA\\n\",\n",
    "    \"solver, corner_dfs, symbols = setup_solver(cm_ota_design)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Loaded {len(corner_dfs)} corner DataFrames\\\")\\n\",\n",
    "    \"print(f\\\"Added {len(solver.equations)} equations\\\")\\n\",\n",
    "    \"print(f\\\"\\\\nCorner DataFrame keys (first 6):\\\")\\n\",\n",
    "    \"for k in list(corner_dfs.keys())[:6]:\\n\",\n",
    "    \"    print(f\\\"  {k}\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Evaluate all design equations\\n\",\n",
    "    \"results = solver.evaluate_equations(symbols_to_add=symbols, corner_dfs=corner_dfs)\\n\",\n",
    "    \"\\n\",\n",
    "    \"if results is not None:\\n\",\n",
    "    \"    print(\\\"✓ Equations evaluated successfully!\\\\n\\\")\\n\",\n",
    "    \"    print(f\\\"{'Symbol':<18} {'Shape':<20} {'Min':<15} {'Max':<15}\\\")\\n\",\n",
    "    \"    print(\\\"-\\\" * 68)\\n\",\n",
    "    \"    for sym in symbols:\\n\",\n",
    "    \"        val = results.get(sym)\\n\",\n",
    "    \"        if val is not None:\\n\",\n",
    "    \"            if isinstance(val, np.ndarray):\\n\",\n",
    "    \"                shape_str = str(val.shape)\\n\",\n",
    "    \"                # Filter out non-finite values for display\\n\",\n",
    "    \"                finite_vals = val[np.isfinite(val)]\\n\",\n",
    "    \"                if len(finite_vals) > 0:\\n\",\n",
    "    \"                    min_str = f\\\"{np.min(finite_vals):.4e}\\\"\\n\",\n",
    "    \"                    max_str = f\\\"{np.max(finite_vals):.4e}\\\"\\n\",\n",
    "    \"                else:\\n\",\n",
    "    \"                    min_str = max_str = \\\"N/A\\\"\\n\",\n",
    "    \"            else:\\n\",\n",
    "    \"                shape_str = \\\"scalar\\\"\\n\",\n",
    "    \"                min_str = max_str = f\\\"{val:.4e}\\\" if isinstance(val, float) else str(val)\\n\",\n",
    "    \"            print(f\\\"{sym:<18} {shape_str:<20} {min_str:<15} {max_str:<15}\\\")\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    print(\\\"✗ Equation evaluation failed.\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### 5.4 Visualizing Design Trade-Offs\\n\",\n",
    "    \"\\n\",\n",
    "    \"ROAR enables the designer to plot any computed expression against any other, revealing the design trade-off space. The plots below show the **drain current**, **voltage gain**, and **GBW** as functions of the gm/ID operating point, evaluated across all PVT corners simultaneously.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"def plot_design_results(results, x_sym, y_sym, xlabel, ylabel, title,\\n\",\n",
    "    \"                        ax=None, yscale='linear', constraint_line=None,\\n\",\n",
    "    \"                        constraint_label=None, positive_only=True):\\n\",\n",
    "    \"    \\\"\\\"\\\"Plot a design equation result (y) vs another (x) across corners.\\\"\\\"\\\"\\n\",\n",
    "    \"    if ax is None:\\n\",\n",
    "    \"        fig, ax = plt.subplots(figsize=(10, 5))\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    x_data = results.get(x_sym)\\n\",\n",
    "    \"    y_data = results.get(y_sym)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    if x_data is None or y_data is None:\\n\",\n",
    "    \"        ax.text(0.5, 0.5, f'Data not available for {x_sym} or {y_sym}',\\n\",\n",
    "    \"                transform=ax.transAxes, ha='center')\\n\",\n",
    "    \"        return ax\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Handle scalar expansion\\n\",\n",
    "    \"    if not isinstance(x_data, np.ndarray):\\n\",\n",
    "    \"        x_data = np.full_like(y_data, x_data) if isinstance(y_data, np.ndarray) else np.array([x_data])\\n\",\n",
    "    \"    if not isinstance(y_data, np.ndarray):\\n\",\n",
    "    \"        y_data = np.full_like(x_data, y_data) if isinstance(x_data, np.ndarray) else np.array([y_data])\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    colors = list(CORNER_COLORS.values())\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    if x_data.ndim == 2:\\n\",\n",
    "    \"        n_corners = x_data.shape[1]\\n\",\n",
    "    \"        for c in range(n_corners):\\n\",\n",
    "    \"            xc = x_data[:, c]\\n\",\n",
    "    \"            yc = y_data[:, c] if y_data.ndim == 2 and c < y_data.shape[1] else y_data.ravel()\\n\",\n",
    "    \"            mask = np.isfinite(xc) & np.isfinite(yc)\\n\",\n",
    "    \"            if positive_only:\\n\",\n",
    "    \"                mask &= (yc > 0)\\n\",\n",
    "    \"            ax.plot(xc[mask], yc[mask], color=colors[c % len(colors)],\\n\",\n",
    "    \"                    linewidth=1.3, alpha=0.8, label=f'Corner {c+1}')\\n\",\n",
    "    \"    elif y_data.ndim == 2:\\n\",\n",
    "    \"        n_corners = y_data.shape[1]\\n\",\n",
    "    \"        xc = x_data.ravel()\\n\",\n",
    "    \"        for c in range(n_corners):\\n\",\n",
    "    \"            yc = y_data[:, c]\\n\",\n",
    "    \"            mask = np.isfinite(xc) & np.isfinite(yc)\\n\",\n",
    "    \"            if positive_only:\\n\",\n",
    "    \"                mask &= (yc > 0)\\n\",\n",
    "    \"            ax.plot(xc[mask], yc[mask], color=colors[c % len(colors)],\\n\",\n",
    "    \"                    linewidth=1.3, alpha=0.8, label=f'Corner {c+1}')\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        mask = np.isfinite(x_data.ravel()) & np.isfinite(y_data.ravel())\\n\",\n",
    "    \"        if positive_only:\\n\",\n",
    "    \"            mask &= (y_data.ravel() > 0)\\n\",\n",
    "    \"        ax.plot(x_data.ravel()[mask], y_data.ravel()[mask], linewidth=1.5)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    if constraint_line is not None:\\n\",\n",
    "    \"        ax.axhline(y=constraint_line, color='red', linestyle='--', linewidth=1.5,\\n\",\n",
    "    \"                   label=constraint_label or f'Spec = {constraint_line:.2e}')\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    ax.set_xlabel(xlabel)\\n\",\n",
    "    \"    ax.set_ylabel(ylabel)\\n\",\n",
    "    \"    ax.set_title(title, fontweight='bold')\\n\",\n",
    "    \"    if yscale == 'log':\\n\",\n",
    "    \"        ax.set_yscale('log')\\n\",\n",
    "    \"    ax.grid(True, alpha=0.3)\\n\",\n",
    "    \"    ax.legend(fontsize=8, ncol=2)\\n\",\n",
    "    \"    return ax\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, axes = plt.subplots(2, 2, figsize=(14, 10))\\n\",\n",
    "    \"fig.suptitle('Current-Mirror OTA — Design Equation Results Across PVT Corners',\\n\",\n",
    "    \"             fontsize=14, fontweight='bold')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Plot drain current i1_2 vs kgm1_2\\n\",\n",
    "    \"plot_design_results(results, 'kgm1_2', 'i1_2',\\n\",\n",
    "    \"                    'gm/ID of M1,2 [V⁻¹]', 'Drain Current I₁,₂ [A]',\\n\",\n",
    "    \"                    'Bias Current vs. gm/ID (Input Pair)',\\n\",\n",
    "    \"                    ax=axes[0, 0], yscale='log')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Plot voltage gain av vs kgm1_2  \\n\",\n",
    "    \"plot_design_results(results, 'kgm1_2', 'av',\\n\",\n",
    "    \"                    'gm/ID of M1,2 [V⁻¹]', 'Voltage Gain Aᵥ [V/V]',\\n\",\n",
    "    \"                    'Voltage Gain vs. gm/ID',\\n\",\n",
    "    \"                    ax=axes[0, 1],\\n\",\n",
    "    \"                    constraint_line=10**(30/20),\\n\",\n",
    "    \"                    constraint_label='Spec: Aᵥ ≥ 30 dB')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Plot current mirror ratio beta vs kgm1_2\\n\",\n",
    "    \"plot_design_results(results, 'kgm1_2', 'beta',\\n\",\n",
    "    \"                    'gm/ID of M1,2 [V⁻¹]', 'Mirror Ratio β',\\n\",\n",
    "    \"                    'Current Mirror Ratio β vs. gm/ID',\\n\",\n",
    "    \"                    ax=axes[1, 0])\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Plot self-loading factor i_sl vs kgm1_2\\n\",\n",
    "    \"plot_design_results(results, 'kgm1_2', 'i_sl',\\n\",\n",
    "    \"                    'gm/ID of M1,2 [V⁻¹]', 'Self-Loading Factor',\\n\",\n",
    "    \"                    'Self-Loading Factor vs. gm/ID',\\n\",\n",
    "    \"                    ax=axes[1, 1])\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout(rect=[0, 0, 1, 0.95])\\n\",\n",
    "    \"plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### 5.5 The \\\"Magic Equation\\\" — Optimal gm/ID Selection\\n\",\n",
    "    \"\\n\",\n",
    "    \"ROAR implements the *Id as a function of gm/ID* trade-off curve (referred to internally as the \\\"magic equation\\\"). This curve captures the fundamental **speed vs. power** trade-off: for a given GBW and load capacitance specification, there exists an **optimal gm/ID** that minimizes drain current — the point where increasing gm/ID (moving toward weak inversion) starts to lose more in self-loading than it gains in transconductance efficiency.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Use CIDDevice to load all corners and compute the magic equation\\n\",\n",
    "    \"nmos_500_device = CIDDevice(\\n\",\n",
    "    \"    device_name='n_01v8_L500',\\n\",\n",
    "    \"    vdd=1.8,\\n\",\n",
    "    \"    lut_directory=os.path.join(ROAR_HOME, 'characterization', 'sky130', 'LUTs_SKY130',\\n\",\n",
    "    \"                               'n_01v8', 'LUT_N_500')\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Design specification\\n\",\n",
    "    \"GBW_target = 100e6   # 100 MHz\\n\",\n",
