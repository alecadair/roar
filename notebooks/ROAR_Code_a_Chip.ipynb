    "    \"             f'GBW = {GBW_target/1e6:.0f} MHz, C_L = {CL_target*1e12:.0f} pF, '\\n\",\n",
    "    \"             f'NMOS n_01v8 L=500 nm',\\n\",\n",
    "    \"             fontsize=12, fontweight='bold')\\n\",\n",
    "    \"ax.legend(fontsize=7, loc='upper right')\\n\",\n",
