    "    \"\\n\",\n",
    "    \"for i, (length_dir, label) in enumerate(zip(lengths, length_labels)):\\n\",\n",
    "    \"    lut_path = os.path.join(ROAR_HOME, 'characterization', 'sky130', 'LUTs_SKY130',\\n\",\n",
    "    \"                            'n_01v8', length_dir, 'nfettt25.csv')\\n\",\n",
    "    \"    if os.path.exists(lut_path):\\n\",\n",
    "    \"        corner = CIDCorner(corner_name=f'tt25_{label}', lut_csv=lut_path, vdd=1.8)\\n\",\n",
    "    \"        df = corner.df\\n\",\n",
