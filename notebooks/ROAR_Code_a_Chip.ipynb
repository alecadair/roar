    "    \"                        ax=axes[0, 1], yscale='log')\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Total gain (Av1 × Av2)\\n\",\n",
    "    \"    plot_design_results(results2, 'kgm1', 'Av_total',\\n\",\n",
    "    \"                        'gm/ID of M1 [V⁻¹]', 'Total Gain Av₁·Av₂ [V/V]',\\n\",\n",
    "    \"                        'Total Open-Loop Gain',\\n\",\n",
    "    \"                        ax=axes[1, 0], yscale='log',\\n\",\n",
    "    \"                        constraint_line=1000,\\n\",\n",
    "    \"                        constraint_label='Spec: Av > 60 dB (1000 V/V)')\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Total current\\n\",\n",
    "    \"    plot_design_results(results2, 'kgm1', 'Itotal',\\n\",\n",
    "    \"                        'gm/ID of M1 [V⁻¹]', 'Total Current [A]',\\n\",\n",
    "    \"                        'Total Power Budget',\\n\",\n",
    "    \"                        ax=axes[1, 1], yscale='log',\\n\",\n",
    "    \"                        constraint_line=500e-6,\\n\",\n",
    "    \"                        constraint_label='Spec: Itotal < 500 µA')\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    plt.tight_layout(rect=[0, 0, 1, 0.95])\\n\",\n",
    "    \"    plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### 6.3 Convergence of the Iterative Solver\\n\",\n",
    "    \"\\n\",\n",
    "    \"To demonstrate the convergence behavior, we run the iterative solver step-by-step and track how the cycle variables evolve.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Track convergence by running the solver with increasing max_iterations\\n\",\n",
    "    \"convergence_history = {var: [] for var in cycle_vars}\\n\",\n",
    "    \"rel_change_history = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"for max_i in range(1, 21):\\n\",\n",
    "    \"    solver_conv, corner_dfs_conv, symbols_conv = setup_solver(two_stage_design)\\n\",\n",
    "    \"    res, inf = solver_conv.evaluate_equations_iterative(\\n\",\n",
    "    \"        symbols_to_add=symbols_conv,\\n\",\n",
    "    \"        corner_dfs=corner_dfs_conv,\\n\",\n",
    "    \"        initial_guesses=initial_guesses,\\n\",\n",
    "    \"        max_iterations=max_i,\\n\",\n",
    "    \"        tolerance=1e-15,  # Very tight so it doesn't stop early\\n\",\n",
    "    \"        damping=1.0\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    rel_change_history.append(inf['max_rel_change'])\\n\",\n",
    "    \"    if res is not None:\\n\",\n",
    "    \"        for var in cycle_vars:\\n\",\n",
    "    \"            val = res.get(var)\\n\",\n",
    "    \"            if val is not None:\\n\",\n",
    "    \"                if isinstance(val, np.ndarray):\\n\",\n",
    "    \"                    convergence_history[var].append(np.mean(val[np.isfinite(val)]))\\n\",\n",
    "    \"                else:\\n\",\n",
    "    \"                    convergence_history[var].append(float(val))\\n\",\n",
    "    \"            else:\\n\",\n",
    "    \"                convergence_history[var].append(np.nan)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Plot convergence\\n\",\n",
    "    \"fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 5))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Relative change per iteration\\n\",\n",
    "    \"ax1.semilogy(range(1, len(rel_change_history) + 1), rel_change_history, 'b-o', linewidth=2)\\n\",\n",
    "    \"ax1.axhline(y=tol, color='red', linestyle='--', label=f'Tolerance = {tol}')\\n\",\n",
    "    \"ax1.set_xlabel('Iteration')\\n\",\n",
    "    \"ax1.set_ylabel('Max Relative Change')\\n\",\n",
    "    \"ax1.set_title('Iterative Solver Convergence', fontweight='bold')\\n\",\n",
    "    \"ax1.legend()\\n\",\n",
