    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"---\\n\",\n",
    "    \"## 6. Iterative Solver — Two-Stage Miller OTA\\n\",\n",
    "    \"\\n\",\n",
    "    \"In multi-stage amplifiers, the design equations form **cyclic dependencies**: the output capacitance of Stage 1 depends on the input capacitance of Stage 2 (which is a function of its transistor sizes), while Stage 2's sizing depends on its load — which includes Stage 1's output parasitics.\\n\",\n",
    "    \"\\n\",\n",
    "    \"ROAR's **iterative solver** resolves these cycles using fixed-point iteration with optional damping:\\n\",\n",
    "    \"\\n\",\n",
    "    \"$$x^{(k+1)} = \\\\lambda \\\\cdot f(x^{(k)}) + (1 - \\\\lambda) \\\\cdot x^{(k)}$$\\n\",\n",
    "    \"\\n\",\n",
    "    \"where $\\\\lambda$ is the damping factor (1.0 = no damping).\\n\",\n",
    "    \"\\n\",\n",
    "    \"### 6.1 Cycle Detection with Tarjan's Algorithm\\n\",\n",
    "    \"\\n\",\n",
    "    \"ROAR uses **Tarjan's algorithm** to find strongly-connected components (SCCs) in the dependency graph. Variables in SCCs of size > 1 are the *cycle variables* that need initial guesses.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Load the two-stage OTA design\\n\",\n",
    "    \"with open(os.path.join(ROAR_HOME, 'design', 'two_stage_ota_iterative.json'), 'r') as f:\\n\",\n",
    "    \"    two_stage_design = json.load(f)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"=\\\" * 70)\\n\",\n",
    "    \"print(\\\"TWO-STAGE MILLER OTA — Design Equations\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 70)\\n\",\n",
    "    \"print(f\\\"{'Symbol':<15} {'Expression':<55}\\\")\\n\",\n",
    "    \"print(\\\"-\\\" * 70)\\n\",\n",
    "    \"for eq in two_stage_design['expression_editor']:\\n\",\n",
    "    \"    sym = eq['Symbol']\\n\",\n",
    "    \"    expr = eq['Expression']\\n\",\n",
    "    \"    disabled = '  [DISABLED]' if eq.get('disabled', False) else ''\\n\",\n",
    "    \"    print(f\\\"{sym:<15} {expr:<55}{disabled}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"\\\\n{'='*70}\\\")\\n\",\n",
    "    \"print(\\\"Constraints\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 70)\\n\",\n",
    "    \"for c in two_stage_design.get('constraint_editor', []):\\n\",\n",
    "    \"    print(f\\\"{c['Symbol']:<15} {c['Constraint Expression']}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"\\\\n{'='*70}\\\")\\n\",\n",
    "    \"print(\\\"Instance Table\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 70)\\n\",\n",
    "    \"for inst in two_stage_design['instance_table']:\\n\",\n",
    "    \"    corners_str = ', '.join([c['name'] for c in inst.get('_corners_data', [])])\\n\",\n",
    "    \"    model = inst['_corners_data'][0]['model'] if inst.get('_corners_data') else '?'\\n\",\n",
    "    \"    length = inst['_corners_data'][0]['length'] if inst.get('_corners_data') else '?'\\n\",\n",
    "    \"    print(f\\\"{inst['Instance']:<8} {model:<12} L={length} nm    [{corners_str}]\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Build the solver and detect cycles\\n\",\n",
    "    \"solver2, corner_dfs2, symbols2 = setup_solver(two_stage_design)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Detect cycle variables using Tarjan's algorithm\\n\",\n",
    "    \"cycle_vars = solver2.find_cycle_variables()\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Dependency graph has {len(solver2.equations)} equations.\\\")\\n\",\n",
    "    \"print(f\\\"\\\\nCycle variables detected ({len(cycle_vars)}):\\\")\\n\",\n",
    "    \"for var in sorted(cycle_vars):\\n\",\n",
    "    \"    print(f\\\"  • {var}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Display the dependency graph\\n\",\n",
    "    \"dep_graph = solver2.build_dependency_graph()\\n\",\n",
    "    \"print(f\\\"\\\\nDependency Graph (equation → depends on):\\\")\\n\",\n",
    "    \"print(\\\"-\\\" * 50)\\n\",\n",
    "    \"for node in sorted(dep_graph.keys()):\\n\",\n",
    "    \"    deps = dep_graph[node]\\n\",\n",
    "    \"    if deps:\\n\",\n",
    "    \"        deps_str = ', '.join(sorted(deps))\\n\",\n",
    "    \"        marker = ' ⟲' if node in cycle_vars else ''\\n\",\n",
    "    \"        print(f\\\"  {node:<12} → {deps_str}{marker}\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### 6.2 Running the Iterative Solver\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Get iterative solver settings from the design JSON\\n\",\n",
    "    \"iter_settings = two_stage_design.get('iterative_solver', {})\\n\",\n",
    "    \"initial_guesses = iter_settings.get('initial_guesses', {})\\n\",\n",
    "    \"max_iter = iter_settings.get('max_iterations', 50)\\n\",\n",
    "    \"tol = iter_settings.get('tolerance', 1e-6)\\n\",\n",
    "    \"damping = iter_settings.get('damping', 1.0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Iterative Solver Settings:\\\")\\n\",\n",
    "    \"print(f\\\"  Max iterations: {max_iter}\\\")\\n\",\n",
    "    \"print(f\\\"  Tolerance:      {tol}\\\")\\n\",\n",
    "    \"print(f\\\"  Damping:        {damping}\\\")\\n\",\n",
    "    \"print(f\\\"\\\\nInitial Guesses:\\\")\\n\",\n",
    "    \"for var, val in initial_guesses.items():\\n\",\n",
    "    \"    print(f\\\"  {var:<12} = {val:.2e}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Run the iterative solver\\n\",\n",
    "    \"print(f\\\"\\\\n{'='*60}\\\")\\n\",\n",
    "    \"print(\\\"Running iterative solver...\\\")\\n\",\n",
    "    \"print(f\\\"{'='*60}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"results2, info = solver2.evaluate_equations_iterative(\\n\",\n",
    "    \"    symbols_to_add=symbols2,\\n\",\n",
    "    \"    corner_dfs=corner_dfs2,\\n\",\n",
    "    \"    initial_guesses=initial_guesses,\\n\",\n",
    "    \"    max_iterations=max_iter,\\n\",\n",
    "    \"    tolerance=tol,\\n\",\n",
    "    \"    damping=damping\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Display convergence results\\n\",\n",
    "    \"if info['converged']:\\n\",\n",
    "    \"    print(f\\\"\\\\n✓ Converged after {info['iterations']} iteration(s)\\\")\\n\",\n",
    "    \"    print(f\\\"  Max relative change: {info['max_rel_change']:.3e}\\\")\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    print(f\\\"\\\\n✗ NOT converged after {info['iterations']} iteration(s)\\\")\\n\",\n",
    "    \"    print(f\\\"  Max relative change: {info['max_rel_change']:.3e}\\\")\\n\",\n",
    "    \"    print(\\\"  → Try lowering damping or increasing max iterations.\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"\\\\nCycle variables: {sorted(info['cycle_variables'])}\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Display the computed design parameters\\n\",\n",
    "    \"if results2 is not None:\\n\",\n",
    "    \"    print(f\\\"\\\\n{'='*75}\\\")\\n\",\n",
    "    \"    print(\\\"Two-Stage OTA — Computed Design Parameters\\\")\\n\",\n",
    "    \"    print(f\\\"{'='*75}\\\")\\n\",\n",
    "    \"    print(f\\\"{'Symbol':<15} {'Shape':<16} {'Min':<18} {'Max':<18} {'Cycle?'}\\\")\\n\",\n",
    "    \"    print(\\\"-\\\" * 75)\\n\",\n",
    "    \"    for sym in symbols2:\\n\",\n",
    "    \"        val = results2.get(sym)\\n\",\n",
    "    \"        is_cycle = '⟲' if sym in info['cycle_variables'] else ''\\n\",\n",
    "    \"        if val is not None:\\n\",\n",
    "    \"            if isinstance(val, np.ndarray):\\n\",\n",
    "    \"                shape_str = str(val.shape)\\n\",\n",
    "    \"                finite_vals = val[np.isfinite(val)]\\n\",\n",
    "    \"                if len(finite_vals) > 0:\\n\",\n",
    "    \"                    min_str = f\\\"{np.min(finite_vals):.4e}\\\"\\n\",\n",
    "    \"                    max_str = f\\\"{np.max(finite_vals):.4e}\\\"\\n\",\n",
    "    \"                else:\\n\",\n",
    "    \"                    min_str = max_str = \\\"N/A\\\"\\n\",\n",
    "    \"            else:\\n\",\n",
    "    \"                shape_str = \\\"scalar\\\"\\n\",\n",
    "    \"                min_str = max_str = f\\\"{val:.4e}\\\" if isinstance(val, (int, float)) else str(val)\\n\",\n",
    "    \"            print(f\\\"{sym:<15} {shape_str:<16} {min_str:<18} {max_str:<18} {is_cycle}\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Visualize the two-stage OTA design trade-offs\\n\",\n",
    "    \"if results2 is not None:\\n\",\n",
    "    \"    fig, axes = plt.subplots(2, 2, figsize=(14, 10))\\n\",\n",
    "    \"    fig.suptitle('Two-Stage Miller OTA — Iterative Solver Results (3 PVT Corners)',\\n\",\n",
    "    \"                 fontsize=14, fontweight='bold')\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Stage 1 current\\n\",\n",
    "    \"    plot_design_results(results2, 'kgm1', 'Id1',\\n\",\n",
    "    \"                        'gm/ID of M1 [V⁻¹]', 'Stage 1 Current Id₁ [A]',\\n\",\n",
    "    \"                        'Stage 1 Drain Current vs. gm/ID',\\n\",\n",
    "    \"                        ax=axes[0, 0], yscale='log')\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Stage 2 current\\n\",\n",
    "    \"    plot_design_results(results2, 'kgm5', 'Id5',\\n\",\n",
    "    \"                        'gm/ID of M5 [V⁻¹]', 'Stage 2 Current Id₅ [A]',\\n\",\n",
