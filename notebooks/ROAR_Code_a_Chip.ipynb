    "    \"\\n\",\n",
    "    \"# Cycle variable evolution\\n\",\n",
    "    \"for var in sorted(cycle_vars):\\n\",\n",
    "    \"    vals = convergence_history[var]\\n\",\n",
    "    \"    if vals and not all(np.isnan(v) for v in vals):\\n\",\n",
    "    \"        ax2.plot(range(1, len(vals) + 1), vals, '-o', label=var, linewidth=1.5, markersize=4)\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax2.set_xlabel('Iteration')\\n\",\n",
    "    \"ax2.set_ylabel('Value (Mean Across Corners)')\\n\",\n",
    "    \"ax2.set_title('Cycle Variable Evolution', fontweight='bold')\\n\",\n",
    "    \"ax2.legend(fontsize=8)\\n\",\n",
    "    \"ax2.grid(True, alpha=0.3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"---\\n\",\n",
    "    \"## 7. SPICE Netlist Generation\\n\",\n",
    "    \"\\n\",\n",
    "    \"ROAR can generate SPICE netlists from the designed circuits. Below is the output netlist for the current-mirror OTA, ready for simulation in ngspice or any SPICE-compatible simulator.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Display the generated SPICE netlist\\n\",\n",
    "    \"spice_path = os.path.join(ROAR_HOME, 'design', 'cm_ota.spice')\\n\",\n",
    "    \"with open(spice_path, 'r') as f:\\n\",\n",
    "    \"    netlist = f.read()\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"=\\\" * 70)\\n\",\n",
    "    \"print(\\\"Generated SPICE Netlist — Current-Mirror OTA (SKY130)\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 70)\\n\",\n",
    "    \"print(netlist)\\n\",\n",
    "    \"print(\\\"=\\\" * 70)\\n\",\n",
    "    \"print(\\\"\\\\nKey observations:\\\")\\n\",\n",
    "    \"print(\\\"  • Transistor widths (w1_2, w3_4, etc.) are parameterized\\\")\\n\",\n",
    "    \"print(\\\"  • ROAR computes these from the design equations: W = ID / (ID/W)\\\")\\n\",\n",
    "    \"print(\\\"  • The designer selects the operating gm/ID from the trade-off curves\\\")\\n\",\n",
    "    \"print(\\\"  • All transistors use L = 500 nm (sky130_fd_pr__nfet_01v8 / pfet_01v8)\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"---\\n\",\n",
    "    \"## 8. Multi-Corner Verification Results\\n\",\n",
    "    \"\\n\",\n",
    "    \"The current-mirror OTA was simulated post-layout (GDS) across three temperature corners. The images below show ROAR's Bode plot results.\\n\",\n",
    "    \"\\n\",\n",
    "    \"### 8.1 GDS Simulation Results\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"from IPython.display import Image, display, HTML\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Display GDS simulation results\\n\",\n",
    "    \"gds_images = [\\n\",\n",
    "    \"    ('cm_ota_-25c_gds.PNG', 'GDS Simulation: T = −25 °C'),\\n\",\n",
    "    \"    ('cm_ota_25c_gds.PNG',  'GDS Simulation: T = 25 °C'),\\n\",\n",
    "    \"    ('cm_ota_75c_gds.PNG',  'GDS Simulation: T = 75 °C'),\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"for img_file, caption in gds_images:\\n\",\n",
    "    \"    img_path = os.path.join(ROAR_HOME, 'images', 'png', img_file)\\n\",\n",
    "    \"    if os.path.exists(img_path):\\n\",\n",
    "    \"        display(HTML(f'<h4>{caption}</h4>'))\\n\",\n",
    "    \"        display(Image(filename=img_path, width=700))\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        print(f\\\"Image not found: {img_path}\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Show the combined all-corners result\\n\",\n",
    "    \"all_corners_img = os.path.join(ROAR_HOME, 'images', 'png', 'cm_ota_all_gds.PNG')\\n\",\n",
    "    \"if os.path.exists(all_corners_img):\\n\",\n",
    "    \"    display(HTML('<h4>GDS Simulation: All Temperature Corners Combined</h4>'))\\n\",\n",
    "    \"    display(Image(filename=all_corners_img, width=700))\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"---\\n\",\n",
    "    \"## 9. PDK Portability Demonstration\\n\",\n",
    "    \"\\n\",\n",
    "    \"ROAR's key differentiator is **PDK agnosticism**. The same design methodology, equations, and GUI work with any process technology — only the LUTs change. Let's demonstrate by comparing device characteristics across available PDKs.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Check what PDKs are available\\n\",\n",
    "    \"tech_list_path = os.path.join(ROAR_HOME, 'tech_list.txt')\\n\",\n",
    "    \"print(\\\"Registered PDKs in tech_list.txt:\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 50)\\n\",\n",
    "    \"with open(tech_list_path, 'r') as f:\\n\",\n",
    "    \"    for line in f:\\n\",\n",
    "    \"        line = line.strip()\\n\",\n",
    "    \"        if line and not line.startswith('#'):\\n\",\n",
    "    \"            print(f\\\"  {line}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Compare SKY130 NMOS vs IHP SG13G2 NMOS (if available)\\n\",\n",
    "    \"ihp_lut_base = os.path.join(ROAR_HOME, 'characterization', 'ihp130', 'LUTs_IHP130')\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 5))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# SKY130 NMOS TT 25C, L=150nm\\n\",\n",
    "    \"sky_path = os.path.join(ROAR_HOME, 'characterization', 'sky130', 'LUTs_SKY130',\\n\",\n",
    "    \"                        'n_01v8', 'LUT_N_150', 'nfettt25.csv')\\n\",\n",
    "    \"if os.path.exists(sky_path):\\n\",\n",
    "    \"    sky_corner = CIDCorner(corner_name='SKY130_tt25', lut_csv=sky_path, vdd=1.8)\\n\",\n",
    "    \"    df_sky = sky_corner.df\\n\",\n",
    "    \"    mask = (df_sky['kgm'] > 0.5) & (df_sky['kgm'] < 30)\\n\",\n",
    "    \"    ax1.semilogy(df_sky.loc[mask, 'kgm'], df_sky.loc[mask, 'ft'],\\n\",\n",
    "    \"                 'b-', linewidth=2, label=f'SKY130 n_01v8 L={sky_corner.length}')\\n\",\n",
    "    \"    ax2.semilogy(df_sky.loc[mask, 'kgm'], df_sky.loc[mask, 'gmro'],\\n\",\n",
    "    \"                 'b-', linewidth=2, label=f'SKY130 n_01v8 L={sky_corner.length}')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Try IHP NMOS\\n\",\n",
    "    \"if os.path.exists(ihp_lut_base):\\n\",\n",
    "    \"    # Find an NMOS model directory\\n\",\n",
    "    \"    for model_dir in os.listdir(ihp_lut_base):\\n\",\n",
    "    \"        if 'nfet' in model_dir.lower() or 'n' == model_dir[0].lower():\\n\",\n",
    "    \"            model_path = os.path.join(ihp_lut_base, model_dir)\\n\",\n",
    "    \"            if os.path.isdir(model_path):\\n\",\n",
    "    \"                # Find first length directory\\n\",\n",
    "    \"                for length_dir in sorted(os.listdir(model_path)):\\n\",\n",
    "    \"                    length_path = os.path.join(model_path, length_dir)\\n\",\n",
    "    \"                    if os.path.isdir(length_path):\\n\",\n",
    "    \"                        # Find a TT corner\\n\",\n",
    "    \"                        for csv_file in os.listdir(length_path):\\n\",\n",
    "    \"                            if 'tt' in csv_file.lower() and csv_file.endswith('.csv'):\\n\",\n",
    "    \"                                ihp_path = os.path.join(length_path, csv_file)\\n\",\n",
    "    \"                                ihp_corner = CIDCorner(corner_name=f'IHP_{csv_file}',\\n\",\n",
    "    \"                                                        lut_csv=ihp_path, vdd=1.2)\\n\",\n",
    "    \"                                df_ihp = ihp_corner.df\\n\",\n",
    "    \"                                mask_ihp = (df_ihp['kgm'] > 0.5) & (df_ihp['kgm'] < 30)\\n\",\n",
    "    \"                                ax1.semilogy(df_ihp.loc[mask_ihp, 'kgm'],\\n\",\n",
    "    \"                                             df_ihp.loc[mask_ihp, 'ft'],\\n\",\n",
    "    \"                                             'r--', linewidth=2,\\n\",\n",
    "    \"                                             label=f'IHP-SG13G2 {model_dir} L={ihp_corner.length}')\\n\",\n",
    "    \"                                ax2.semilogy(df_ihp.loc[mask_ihp, 'kgm'],\\n\",\n",
    "    \"                                             df_ihp.loc[mask_ihp, 'gmro'],\\n\",\n",
    "    \"                                             'r--', linewidth=2,\\n\",\n",
    "    \"                                             label=f'IHP-SG13G2 {model_dir} L={ihp_corner.length}')\\n\",\n",
    "    \"                                break\\n\",\n",
    "    \"                        break\\n\",\n",
    "    \"            break\\n\",\n",
    "    \"\\n\",\n",
    "    \"for ax, ylabel, title in [\\n\",\n",
    "    \"    (ax1, 'fₜ [Hz]', 'Transit Frequency Comparison'),\\n\",\n",
    "    \"    (ax2, 'gm·rₒ [V/V]', 'Intrinsic Gain Comparison'),\\n\",\n",
    "    \"]:\\n\",\n",
    "    \"    ax.set_xlabel('gm/ID [V⁻¹]')\\n\",\n",
    "    \"    ax.set_ylabel(ylabel)\\n\",\n",
    "    \"    ax.set_title(title, fontweight='bold')\\n\",\n",
    "    \"    ax.legend(fontsize=9)\\n\",\n",
    "    \"    ax.grid(True, alpha=0.3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.suptitle('Cross-PDK Device Comparison — ROAR LUT Framework',\\n\",\n",
    "    \"             fontsize=13, fontweight='bold')\\n\",\n",
    "    \"plt.tight_layout(rect=[0, 0, 1, 0.94])\\n\",\n",
    "    \"plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"---\\n\",\n",
    "    \"## 10. ROAR GUI Overview\\n\",\n",
    "    \"\\n\",\n",
    "    \"While this notebook demonstrates ROAR's capabilities programmatically, the full ROAR application provides a rich **PyQt6-based GUI** with:\\n\",\n",
    "    \"\\n\",\n",
    "    \"- **Tech Browser** — Hierarchical tree for navigating PDKs, models, lengths, and corners  \\n\",\n",
    "    \"- **Lookup Windows** — Real-time interactive plots of device and design-equation curves  \\n\",\n",
    "    \"- **Design Editor** — Expression editor, constraint editor, and instance table  \\n\",\n",
    "    \"- **Iterative Solver Dialog** — Automatic cycle detection and convergence monitoring  \\n\",\n",
    "    \"- **SPICE Netlist Generator** — Export sized circuits for simulation  \\n\",\n",
    "    \"- **Python Console** — Built-in REPL for scripting within the application  \\n\",\n",
    "    \"\\n\",\n",
    "    \"### Screenshots\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Display available GUI screenshots\\n\",\n",
    "    \"gui_images = [\\n\",\n",
    "    \"    ('fig_four_graphs_small.png', 'ROAR GUI — Four Canonical gm/ID Plots'),\\n\",\n",
    "    \"    ('fig_bode_plot.png', 'ROAR GUI — Bode Plot Visualization'),\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"for img_file, caption in gui_images:\\n\",\n",
    "    \"    img_path = os.path.join(ROAR_HOME, 'images', 'png', img_file)\\n\",\n",
    "    \"    if os.path.exists(img_path):\\n\",\n",
    "    \"        display(HTML(f'<h4>{caption}</h4>'))\\n\",\n",
    "    \"        display(Image(filename=img_path, width=700))\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        print(f\\\"Image not found: {img_file}\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"---\\n\",\n",
    "    \"## 11. Summary and Conclusions\\n\",\n",
    "    \"\\n\",\n",
    "    \"### What ROAR Provides\\n\",\n",
    "    \"\\n\",\n",
    "    \"| Feature | Description |\\n\",\n",
    "    \"|---------|-------------|\\n\",\n",
    "    \"| **PDK-Agnostic Design** | Works with any process via CSV lookup tables |\\n\",\n",
    "    \"| **gm/ID Methodology** | Unified weak-to-strong inversion design framework |\\n\",\n",
    "    \"| **Multi-Corner Analysis** | Simultaneous evaluation across 9+ PVT corners |\\n\",\n",
    "    \"| **Symbolic Expressions** | SymPy-based equation engine with topological sorting |\\n\",\n",
    "    \"| **Iterative Solver** | Tarjan's SCC detection + fixed-point iteration with damping |\\n\",\n",
    "    \"| **Interactive GUI** | PyQt6 app with real-time plotting and tech browser |\\n\",\n",
    "    \"| **SPICE Generation** | Automated netlist export for simulation verification |\\n\",\n",
    "    \"| **Open-Source PDKs** | Ships with SKY130 and IHP SG13G2 LUTs |\\n\",\n",
    "    \"\\n\",\n",
    "    \"### Design Flow Summary\\n\",\n",
    "    \"\\n\",\n",
    "    \"```\\n\",\n",
    "    \"┌─────────────────┐    ┌──────────────────┐    ┌─────────────────┐\\n\",\n",
    "    \"│  Characterize    │    │   Design in ROAR  │    │   Verify in      │\\n\",\n",
    "    \"│  (ngspice/       │ →  │   (gm/ID curves,  │ →  │   SPICE           │\\n\",\n",
    "    \"│   Spectre/HSPICE)│    │    equations,      │    │   (ngspice/       │\\n\",\n",
    "    \"│                  │    │    constraints)     │    │    Spectre)       │\\n\",\n",
    "    \"│  → CSV LUTs      │    │  → Sized netlist   │    │  → Layout (GDS)  │\\n\",\n",
    "    \"└─────────────────┘    └──────────────────┘    └─────────────────┘\\n\",\n",
    "    \"```\\n\",\n",
    "    \"\\n\",\n",
    "    \"### Demonstrated in This Notebook\\n\",\n",
    "    \"\\n\",\n",
    "    \"1. ✅ Loaded and inspected SKY130 lookup tables (325 bias points × 9 PVT corners)  \\n\",\n",
    "    \"2. ✅ Visualized the four canonical gm/ID design curves across all corners  \\n\",\n",
    "    \"3. ✅ Analyzed process variation impact on fₜ and gm·rₒ  \\n\",\n",
    "    \"4. ✅ Compared device characteristics across channel lengths  \\n\",\n",
    "    \"5. ✅ Designed a current-mirror OTA using ROAR's equation solver  \\n\",\n",
    "    \"6. ✅ Demonstrated the iterative solver on a two-stage Miller OTA with cyclic dependencies  \\n\",\n",
    "    \"7. ✅ Tracked solver convergence using Tarjan's cycle detection  \\n\",\n",
    "    \"8. ✅ Showed GDS-level post-layout simulation results  \\n\",\n",
    "    \"9. ✅ Demonstrated cross-PDK portability (SKY130 vs. IHP SG13G2)  \\n\",\n",
    "    \"\\n\",\n",
    "    \"### Future Work\\n\",\n",
    "    \"\\n\",\n",
    "    \"- **Layout automation integration** (ALIGN, Magic)  \\n\",\n",
    "    \"- **Optimization engine** — automated gm/ID selection for multi-objective targets  \\n\",\n",
    "    \"- **Additional PDK support** — GF180, TSMC N7 (with appropriate NDAs)  \\n\",\n",
    "    \"- **Monte Carlo aware design** — statistical corner analysis  \\n\",\n",
    "    \"- **Hierarchical design** — reusable block-level templates  \\n\",\n",
    "    \"\\n\",\n",
    "    \"---\\n\",\n",
    "    \"\\n\",\n",
    "    \"*ROAR is open-source software developed by Alec S. Adair.*  \\n\",\n",
    "    \"*Submitted to the IEEE SSCS Code-a-Chip Challenge, 2026.*\"\n",
    "   ]\n",
