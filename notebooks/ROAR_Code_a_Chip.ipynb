    "    \"\\n\",\n",
    "    \"fig, ax = plt.subplots(figsize=(10, 6))\\n\",\n",
    "    \"\\n\",\n",
    "    \"colors = list(CORNER_COLORS.values())\\n\",\n",
    "    \"min_ids_all = []\\n\",\n",
    "    \"kgm_opt_all = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"for i, corner in enumerate(nmos_500_device.corners):\\n\",\n",
    "    \"    legend = f\\\"{corner.pdk}, L={corner.length}, {corner.corner_name}\\\"\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Compute Id vs kgm using the magic equation\\n\",\n",
    "    \"    graph_x, graph_y = [], []\\n\",\n",
    "    \"    kgm_col = corner.df['kgm'].values\\n\",\n",
    "    \"    kcgd_col = corner.df['kcgd'].values\\n\",\n",
    "    \"    kcgs_col = corner.df['kcgs'].values\\n\",\n",
    "    \"    kcds_col = corner.df['kcds'].values\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    min_ids = 1e9\\n\",\n",
    "    \"    kgm_opt = 0\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    for j in range(len(kgm_col)):\\n\",\n",
    "    \"        kgm = kgm_col[j]\\n\",\n",
    "    \"        kcgd = kcgd_col[j]\\n\",\n",
    "    \"        kcgs = kcgs_col[j]\\n\",\n",
    "    \"        kcds = kcds_col[j]\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        strong_inv = 2 * np.pi * GBW_target * CL_target / kgm\\n\",\n",
    "    \"        weak_inv = 1 / (1 - 2 * np.pi * GBW_target * (kcgd + kcgs + kcds) / kgm)\\n\",\n",
    "    \"        ids = strong_inv * weak_inv\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        if ids > 0:\\n\",\n",
    "    \"            graph_x.append(kgm)\\n\",\n",
    "    \"            graph_y.append(ids)\\n\",\n",
    "    \"            if ids < min_ids:\\n\",\n",
    "    \"                min_ids = ids\\n\",\n",
    "    \"                kgm_opt = kgm\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    ax.semilogy(graph_x, graph_y, color=colors[i % len(colors)],\\n\",\n",
    "    \"                linewidth=1.3, label=legend, alpha=0.85)\\n\",\n",
    "    \"    min_ids_all.append(min_ids)\\n\",\n",
    "    \"    kgm_opt_all.append(kgm_opt)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Mark the optimal points\\n\",\n",
    "    \"for i, (kgm_o, ids_o) in enumerate(zip(kgm_opt_all, min_ids_all)):\\n\",\n",
    "    \"    ax.plot(kgm_o, ids_o, 'o', color=colors[i % len(colors)],\\n\",\n",
    "    \"            markersize=6, markeredgecolor='black', markeredgewidth=0.5)\\n\",\n",
